<Window x:Class="AdbView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="adbView" Width="420" Height="820" MinWidth="240" MinHeight="360"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">
  <Window.Resources>
    <!-- Own template: no theme "pressed" colours, so icons never turn black-on-black in dark mode -->
    <Style x:Key="Tool" TargetType="ButtonBase">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#22808080"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#44808080"/>
              </Trigger>
              <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#33808080"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Tool}">
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="Width" Value="72"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Phone screen: edge to edge, no padding -->
    <Grid x:Name="ScreenArea" Background="Black" Focusable="True" FocusVisualStyle="{x:Null}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Image x:Name="ScreenImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"
             MouseLeftButtonDown="Screen_MouseDown" MouseLeftButtonUp="Screen_MouseUp" MouseMove="Screen_MouseMove"
             MouseRightButtonUp="Screen_RightUp" MouseWheel="Screen_Wheel"/>
      <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8EA;" FontSize="44" Foreground="#77FFFFFF"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="PlaceholderText" Margin="16,12,16,0" TextAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="260" Foreground="#AAFFFFFF"/>
      </StackPanel>
      <!-- 3 Android nav buttons: only for phones without an on-screen nav bar -->
      <Grid x:Name="NavBar" Grid.Row="1" Background="Black">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="RecentsBtn" Style="{StaticResource Nav}" Content="&#xE7C4;" Click="Recents_Click"/>
          <Button x:Name="HomeBtn" Style="{StaticResource Nav}" Content="&#xEA3A;" Click="Home_Click"/>
          <Button x:Name="BackBtn" Style="{StaticResource Nav}" Content="&#xE72B;" Click="Back_Click"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Slim toolbar -->
    <DockPanel x:Name="Sidebar" Grid.Column="1" Width="48" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <ToggleButton x:Name="SettingsBtn" DockPanel.Dock="Bottom" Style="{StaticResource Tool}" Content="&#xE713;" Margin="0,2,0,8"/>
      <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center">
        <Button x:Name="PowerBtn" Style="{StaticResource Tool}" Content="&#xE7E8;" Click="Power_Click"/>
        <Button x:Name="VolUpBtn" Style="{StaticResource Tool}" Content="&#xE995;" Click="VolUp_Click"/>
        <Button x:Name="VolDownBtn" Style="{StaticResource Tool}" Content="&#xE993;" Click="VolDown_Click"/>
        <Button x:Name="ShotBtn" Style="{StaticResource Tool}" Content="&#xE722;" Click="Shot_Click"/>
      </StackPanel>
    </DockPanel>

    <Popup PlacementTarget="{Binding ElementName=SettingsBtn}" Placement="Left" StaysOpen="False"
           IsOpen="{Binding IsChecked, ElementName=SettingsBtn, Mode=TwoWay}" AllowsTransparency="True">
      <Border Width="250" Padding="14" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <StackPanel>
          <TextBlock x:Name="DeviceLabel" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
          <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                    SelectionChanged="DeviceBox_Changed"/>
          <TextBlock x:Name="WirelessLabel" Style="{StaticResource Caption}"/>
          <DockPanel>
            <Button x:Name="ConnectBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Click="Connect_Click"/>
            <TextBox x:Name="AddrBox" KeyDown="AddrBox_KeyDown"/>
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <Button x:Name="PairBtn" DockPanel.Dock="Right" Margin="6,0,0,0" Click="Pair_Click"/>
            <TextBox x:Name="PairCodeBox" Width="80" HorizontalAlignment="Left" MaxLength="6"/>
          </DockPanel>
          <Button x:Name="TcpipBtn" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="Tcpip_Click"/>
          <TextBlock x:Name="QualityLabel" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="QualityBox" HorizontalAlignment="Stretch" SelectionChanged="Quality_Changed"/>
          <TextBlock x:Name="LanguageLabel" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" SelectionChanged="Language_Changed">
            <ComboBoxItem Content="English"/>
            <ComboBoxItem Content="Tiếng Việt"/>
          </ComboBox>
          <TextBlock x:Name="ThemeLabel" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" SelectionChanged="Theme_Changed"/>
          <TextBlock x:Name="Status" Margin="0,12,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
